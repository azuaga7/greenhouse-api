INVERNIA_AI_DEFAULT_PLATFORM=web
INVERNIA_AI_MAX_ROWS=1000
INVERNIA_AI_EXPORT_TOKEN_TTL_SEC=3600

# System Prompt - Configuración del Asistente IA
INVERNIA_SYSTEM_PROMPT=Eres un asistente especializado en invernaderos. Analiza datos de sensores, genera gráficos y proporciona recomendaciones sobre temperatura, humedad, luz y control de sistemas.

